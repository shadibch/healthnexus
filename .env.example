# PostgreSQL
POSTGRES_USER=healthnexus
POSTGRES_PASSWORD=healthnexus
POSTGRES_DB=healthnexus
POSTGRES_PORT=5432

# API server
API_PORT=8080
NODE_ENV=development

# Session signing secret (required in production)
SESSION_SECRET=change-me-in-production

# Email (SMTP) — used for verification + password-reset emails.
# Leave SMTP_HOST empty to log emails instead of sending (dev only).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HealthNexus <no-reply@yourdomain.com>

# Public base URL used to build verification / password-reset links in emails
# e.g. http://localhost:8080 locally, or https://healthnexus.onrender.com on Render
APP_BASE_URL=http://localhost:8080

# Optional integrations
OPENAI_API_KEY=
