# PostgreSQL
POSTGRES_USER=healthnexus
POSTGRES_PASSWORD=healthnexus
POSTGRES_DB=healthnexus
POSTGRES_PORT=5432

# API server
API_PORT=8080
NODE_ENV=development

# Session signing secret (required in production)
SESSION_SECRET=change-me-in-production

# Email (SMTP) — used for verification + password-reset emails.
# Leave SMTP_HOST empty to log emails instead of sending (dev only).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HealthNexus <no-reply@yourdomain.com>
FEEDBACK_EMAIL=support@camsclinic.org

# Alternative email provider — Resend HTTP API (HTTPS/443).
# Prefer this on Render free tier, which blocks outbound SMTP (25/465/587).
# If RESEND_API_KEY is set it takes precedence over SMTP.
# https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=
RESEND_FROM=HealthNexus <no-reply@yourdomain.com>

# Alternative email provider — Hostinger Mail API (HTTPS/443).
# If you already have a Hostinger mailbox (Agentic Mail), this is the easiest
# way to send on Render free tier — emails go out from your own mailbox.
# Token: hPanel → email domain → Agentic Mail → API access → Create API token.
# Mailbox ID: resource ID of the sending mailbox (e.g. info@yourdomain.com).
# If set, this takes precedence over Resend and SMTP.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=

# Public base URL used to build verification / password-reset links in emails
# e.g. http://localhost:8080 locally, or https://healthnexus.onrender.com on Render
APP_BASE_URL=http://localhost:8080

# Optional integrations
OPENAI_API_KEY=
