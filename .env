# PostgreSQL — LOCAL docker-compose values only.
# Render connection details belong in the Render dashboard, not here.
# (Render DB reference: dpg-da5irsjm8hqs73cs7gcg-a.frankfurt-postgres.render.com, db healthnexus_yuhy)
DATABASE_URL=postgresql://healthnexus:healthnexus@db:5432/healthnexus
POSTGRES_USER=healthnexus
POSTGRES_PASSWORD=healthnexus
POSTGRES_DB=healthnexus
POSTGRES_PORT=5433
# API server
API_PORT=8080
NODE_ENV=development
# Optional integrations
SESSION_SECRET=dev-session-secret-change-me
OPENAI_API_KEY=

# Email (SMTP) — Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@camsclinic.org
SMTP_PASS=***REMOVED***
SMTP_FROM=HealthNexus <info@camsclinic.org>

# Public base URL used to build verification / password-reset links in emails
# e.g. http://localhost:8080 locally, or https://healthnexus.onrender.com on Render
APP_BASE_URL=http://localhost:8080